@model List<RecetteCategorieVM>
@{
    ViewData["Title"] = "Recettes";
}

<h1>Recettes</h1>

<div class="accordion" id="accordionRecettes">
    @foreach (var cat in Model)
    {
        bool premiere = cat == Model.First();
        string collapseId = "collapse" + cat.Id;

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button @(premiere ? "" : "collapsed")"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        aria-expanded="@(premiere ? "true" : "false")"
                        aria-controls="@collapseId">
                    @cat.Nom
                </button>
            </h2>

            <div id="@collapseId"
                 class="accordion-collapse collapse @(premiere ? "show" : "")"
                 data-bs-parent="#accordionRecettes">
                <div class="accordion-body">
                    <partial name="_RecetteCategorie" model="cat" />
                </div>
            </div>
        </div>
    }
</div>