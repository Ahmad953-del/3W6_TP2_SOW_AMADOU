@model NutriVie.Models.Recettes

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Recettes</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TempsPreparation" class="control-label"></label>
                <input asp-for="TempsPreparation" class="form-control" />
                <span asp-validation-for="TempsPreparation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TempsCuisson" class="control-label"></label>
                <input asp-for="TempsCuisson" class="form-control" />
                <span asp-validation-for="TempsCuisson" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="form-group">
                <!-- Le texte écrit ici ("Catégorie") remplace et écrase définitivement le nom de la propriété "CategorieId" à l'affichage -->
                <label asp-for="Categorie" class="control-label">Categorie</label>

                <!-- Le sélecteur affiche le Nom de la catégorie et stocke son Id en arrière-plan -->
                <select asp-for="CategorieId" asp-items="ViewBag.Categorie" class="form-control"></select>

                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div>
                <partial name="_SubmitButtonPartial" model='"Create"' />
                @* <input type="submit" value="Create" class="btn btn-primary" /> *@
            </div>
        </form>
    </div>
</div>

<partial name="_BackToListButtonPartial" />
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
