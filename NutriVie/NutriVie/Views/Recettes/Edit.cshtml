@model NutriVie.Models.Recettes

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Recettes</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">@Model.Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TempsPreparation" class="control-label"></label>
                <input asp-for="TempsPreparation" class="form-control" />
                <span asp-validation-for="TempsPreparation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TempsCuisson" class="control-label"></label>
                <input asp-for="TempsCuisson" class="form-control" />
                <span asp-validation-for="TempsCuisson" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Image" class="control-label"></label>
                <input asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategorieId" class="control-label">Categorie</label>
                <select asp-for="CategorieId" asp-items="ViewBag.Categorie" class="form-control"></select>
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="Categorie" class="control-label">@Model.Categorie.Nom</label>
                <input asp-for="Categorie" class="form-control" />
                <span asp-validation-for="Categorie" class="text-danger"></span>
            </div> *@
            <partial name="_SubmitButtonPartial" model='"Edit"' />
        </form>
    </div>
</div>

<partial name="_BackToListButtonPartial" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
