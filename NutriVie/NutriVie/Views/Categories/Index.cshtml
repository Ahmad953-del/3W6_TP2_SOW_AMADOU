@model IEnumerable<NutriVie.Models.Categorie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Id)
            </th> *@
            <th>Recettes</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nom)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Nom)
            </td> *@
            <td>
                    @if(item.Recettes != null && item.Recettes.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach(var recette in item.Recettes)
                            {
                                <li>
                                    <a asp-controller="Recettes" asp-action="Edit" asp-route-id="@recette.Id">
                                        @recette.Nom (@recette.TempsPreparation min</a>
                                </li>
                            }
                        </ul>
                    }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
