
@{
    string statut;
    string couleur;

    if (Model.tempsTotal >= 120)
    {
        statut = "Recette de longue durée";
        couleur = "text-danger";
    }
    else if (Model.tempsTotal >= 60)
    {
        statut = "Recette de durée moyenne";
        couleur = "text-warning";
    }
    else
    {
        statut = "Recette de courte durée";
        couleur = "text-success";
    }
}

<tr>
    <td>@Model.Nom</td>
    <td>@Model.NbrIngrediens</td>
    <td>@Model.tempsTotal</td>
    <td class="@couleur">@statut</td>
</tr>